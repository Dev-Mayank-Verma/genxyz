# Telegram
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_WEBHOOK_SECRET=replace_me
PUBLIC_BASE_URL=https://your-service.onrender.com

# Database (Render Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Registrar integration
# IMPORTANT: only use an API/partner integration you are authorized to use.
REGISTRAR_BASE_URL=https://api.example.com
REGISTRAR_API_KEY=replace_me
REGISTRAR_AVAILABILITY_PATH=/domains/availability
REGISTRAR_PRICE_PATH=/domains/price
REGISTRAR_REGISTER_PATH=/domains/register
REGISTRAR_STATUS_PATH=/orders/{order_id}

# Legitimate promotion/coupon supplied by your registrar/partner agreement.
REGISTRAR_COUPON_CODE=

# Optional
APP_ENV=production
